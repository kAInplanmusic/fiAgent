{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prain:schema:delegation-grant:1.0.0",
  "title": "PRAIN Delegation Grant",
  "description": "No wildcard scope is implied. Authority may only be narrowed through delegation, never expanded.",
  "type": "object",
  "properties": {
    "delegation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "grantor_principal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "grantee_principal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "capability_allowlist": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "target_scope": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:prain:schema:inline-target-scope:1.0.0",
      "title": "Delegation target scope",
      "description": "",
      "type": "object",
      "properties": {
        "resource_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          }
        },
        "resource_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "required": [],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "resource_refs"
          ]
        },
        {
          "required": [
            "resource_classes"
          ]
        }
      ]
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 100
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "max_uses": {
      "type": "integer",
      "minimum": 1
    },
    "use_count": {
      "type": "integer",
      "minimum": 0
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "revoked",
        "expired",
        "exhausted"
      ]
    },
    "revocation_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "issued_by_policy_decision_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "schema_version": {
      "const": "1.0.0"
    }
  },
  "required": [
    "delegation_id",
    "tenant_id",
    "grantor_principal_id",
    "grantee_principal_id",
    "capability_allowlist",
    "target_scope",
    "valid_from",
    "valid_until",
    "lifecycle_status",
    "revocation_epoch",
    "issued_by_policy_decision_ref",
    "created_at",
    "schema_version"
  ],
  "additionalProperties": false
}
