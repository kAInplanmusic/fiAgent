{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prain:schema:action-command:1.0.0",
  "title": "PRAIN Action Command",
  "description": "Immutable dispatch intent. action_digest canonically binds command scope and authorization_context; does not imply execution success.",
  "type": "object",
  "properties": {
    "command_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "goal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "actor_principal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "capability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "target_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "input_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "input_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "declared_side_effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "risk_class": {
      "type": "string",
      "enum": [
        "low",
        "moderate",
        "high",
        "critical"
      ]
    },
    "policy_decision_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "approval_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
      },
      "uniqueItems": true
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 256
    },
    "retry_class": {
      "type": "string",
      "enum": [
        "never",
        "read_safe",
        "idempotent",
        "reconcile_before_retry"
      ]
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "dispatch_not_before": {
      "type": "string",
      "format": "date-time"
    },
    "lease": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:prain:schema:inline-lease:1.0.0",
      "title": "Execution lease",
      "description": "",
      "type": "object",
      "properties": {
        "worker_principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "lease_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "fencing_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "worker_principal_id",
        "lease_epoch",
        "fencing_token",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "authorization_context": {
      "title": "Immutable authorization context bound into action_digest",
      "type": "object",
      "properties": {
        "identity_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revocation_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "delegation_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          },
          "uniqueItems": true
        },
        "policy_rule_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          },
          "uniqueItems": true
        },
        "data_classification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "access_scope_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "identity_version",
        "revocation_epoch",
        "delegation_refs",
        "policy_rule_refs",
        "data_classification",
        "access_scope_digest"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "command_id",
    "tenant_id",
    "goal_id",
    "plan_id",
    "actor_principal_id",
    "capability",
    "action",
    "target_ref",
    "input_digest",
    "declared_side_effects",
    "risk_class",
    "policy_decision_ref",
    "policy_version",
    "idempotency_key",
    "retry_class",
    "deadline",
    "created_at",
    "schema_version",
    "authorization_context"
  ],
  "additionalProperties": false
}
