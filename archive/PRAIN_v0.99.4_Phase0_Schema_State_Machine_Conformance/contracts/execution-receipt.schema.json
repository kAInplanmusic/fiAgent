{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prain:schema:execution-receipt:1.0.0",
  "title": "PRAIN Execution Receipt",
  "description": "Append-only receipt event. Each correction or reconciliation creates a new receipt; never overwrite prior status. Unknown outcome is durable and blocks blind retry.",
  "type": "object",
  "properties": {
    "receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "command_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "accepted",
        "started",
        "effect_possible",
        "effect_observed",
        "verified",
        "failed_pre_effect",
        "unknown",
        "reconciliation_required",
        "compensated"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "executor_principal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "external_operation_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
      },
      "uniqueItems": true
    },
    "side_effects_observed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 500
    },
    "error_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "reconciliation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:prain:schema:inline-reconciliation:1.0.0",
      "title": "Execution reconciliation",
      "description": "",
      "type": "object",
      "properties": {
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "result": {
          "type": "string",
          "enum": [
            "effect_present",
            "effect_absent",
            "indeterminate"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          },
          "uniqueItems": true
        },
        "next_action": {
          "type": "string",
          "enum": [
            "verify",
            "do_not_retry",
            "retry_if_policy_allows",
            "compensate",
            "escalate"
          ]
        }
      },
      "required": [
        "checked_at",
        "method",
        "result",
        "evidence_refs",
        "next_action"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "const": "effect_absent"
              }
            },
            "required": [
              "result"
            ]
          },
          "then": {
            "properties": {
              "next_action": {
                "enum": [
                  "retry_if_policy_allows",
                  "escalate"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "const": "effect_present"
              }
            },
            "required": [
              "result"
            ]
          },
          "then": {
            "properties": {
              "next_action": {
                "enum": [
                  "verify",
                  "do_not_retry",
                  "compensate",
                  "escalate"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "const": "indeterminate"
              }
            },
            "required": [
              "result"
            ]
          },
          "then": {
            "properties": {
              "next_action": {
                "const": "escalate"
              }
            }
          }
        }
      ]
    },
    "supersedes_receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "verification_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "verifier_principal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    }
  },
  "required": [
    "receipt_id",
    "command_id",
    "tenant_id",
    "attempt",
    "status",
    "observed_at",
    "executor_principal_id",
    "evidence_refs",
    "schema_version"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "unknown"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "reconciliation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "reconciliation_required"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "reconciliation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "verified"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "verified"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "verification_ref",
          "verifier_principal_id"
        ],
        "properties": {
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "effect_observed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "evidence_refs": {
            "minItems": 1
          },
          "side_effects_observed": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed_pre_effect"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "error_code"
        ],
        "properties": {
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "compensated"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
