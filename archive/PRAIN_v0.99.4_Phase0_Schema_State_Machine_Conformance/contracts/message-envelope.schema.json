{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prain:schema:message-envelope:1.0.0",
  "title": "PRAIN Message Envelope",
  "description": "Transport envelope and semantic payload are separate. Tenant context is mandatory.",
  "type": "object",
  "properties": {
    "message_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "event",
        "command",
        "query",
        "response",
        "receipt",
        "notification"
      ]
    },
    "schema_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "payload_schema_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "envelope_version": {
      "const": "1.0.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer_principal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "recipient_principal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "causation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 256
    },
    "classification": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
      },
      "uniqueItems": true
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "message_id",
    "message_type",
    "schema_id",
    "payload_schema_version",
    "envelope_version",
    "created_at",
    "producer_principal_id",
    "tenant_id",
    "correlation_id",
    "classification",
    "provenance_refs",
    "payload"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "command"
          }
        },
        "required": [
          "message_type"
        ]
      },
      "then": {
        "required": [
          "recipient_principal_id",
          "idempotency_key",
          "expires_at"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "response"
          }
        },
        "required": [
          "message_type"
        ]
      },
      "then": {
        "required": [
          "causation_id"
        ]
      }
    }
  ]
}
