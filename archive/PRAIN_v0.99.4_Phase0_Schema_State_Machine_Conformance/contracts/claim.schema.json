{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prain:schema:claim:1.0.0",
  "title": "PRAIN Canonical Claim",
  "description": "A scoped and revisioned claim. Confidence does not establish verification.",
  "type": "object",
  "properties": {
    "claim_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "claim_kind": {
      "type": "string",
      "enum": [
        "factual",
        "interpretive",
        "predictive",
        "normative",
        "state",
        "capability",
        "identity",
        "other"
      ]
    },
    "proposition": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:prain:schema:inline-proposition:1.0.0",
      "title": "Normalized proposition",
      "description": "",
      "type": "object",
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "subject_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "predicate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "object_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 35
        }
      },
      "required": [
        "statement"
      ],
      "additionalProperties": false
    },
    "scope": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:prain:schema:inline-scope:1.0.0",
      "title": "Scope",
      "description": "",
      "type": "object",
      "properties": {
        "domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "subject_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 100
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "domain"
      ],
      "additionalProperties": false
    },
    "epistemic_status": {
      "type": "string",
      "enum": [
        "observed",
        "reported",
        "inferred",
        "hypothesized",
        "corroborated",
        "verified",
        "disputed",
        "refuted",
        "unknown"
      ]
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "not_checked",
        "pending",
        "passed",
        "failed",
        "inconclusive",
        "stale",
        "not_applicable"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "confidence_method": {
      "type": "string",
      "enum": [
        "calibrated_probability",
        "model_self_estimate",
        "human_assessment",
        "domain_score",
        "ordinal_rubric",
        "unknown_legacy_method"
      ]
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:prain:schema:inline-provenance:1.0.0",
        "title": "Claim provenance",
        "description": "",
        "type": "object",
        "properties": {
          "origin_type": {
            "type": "string",
            "enum": [
              "sensor",
              "tool",
              "human_report",
              "external_source",
              "inference",
              "system_event",
              "legacy_unknown"
            ]
          },
          "source_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          },
          "producer_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "transformation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "method_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "parent_claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "origin_type",
          "producer_id",
          "occurred_at",
          "recorded_at"
        ],
        "additionalProperties": false
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
      },
      "uniqueItems": true
    },
    "counterevidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
      },
      "uniqueItems": true
    },
    "valid_time": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:prain:schema:inline-valid-time:1.0.0",
      "title": "Claim validity interval",
      "description": "",
      "type": "object",
      "properties": {
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "valid_from"
      ],
      "additionalProperties": false
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "verification_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "refutation_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
      },
      "uniqueItems": true
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
      },
      "uniqueItems": true
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "active",
        "superseded",
        "withdrawn",
        "quarantined"
      ]
    },
    "lifecycle_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "legacy_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
      },
      "uniqueItems": true
    },
    "schema_version": {
      "const": "1.0.0"
    }
  },
  "required": [
    "claim_id",
    "revision",
    "tenant_id",
    "claim_kind",
    "proposition",
    "scope",
    "epistemic_status",
    "verification_status",
    "provenance",
    "recorded_at",
    "lifecycle_status",
    "schema_version"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": [
          "confidence"
        ]
      },
      "then": {
        "required": [
          "confidence_method"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "epistemic_status": {
            "const": "verified"
          }
        },
        "required": [
          "epistemic_status"
        ]
      },
      "then": {
        "properties": {
          "verification_status": {
            "const": "passed"
          }
        },
        "required": [
          "verification_ref"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "epistemic_status": {
            "const": "refuted"
          }
        },
        "required": [
          "epistemic_status"
        ]
      },
      "then": {
        "properties": {
          "verification_status": {
            "const": "failed"
          },
          "refutation_refs": {
            "minItems": 1
          }
        },
        "required": [
          "refutation_refs"
        ]
      }
    }
  ]
}
