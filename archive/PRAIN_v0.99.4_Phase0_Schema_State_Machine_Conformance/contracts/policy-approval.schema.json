{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prain:schema:policy-approval:1.0.0",
  "title": "PRAIN Action-Bound Approval",
  "description": "An immutable approval or rejection record with explicit lifecycle status and action-bound identity/policy context.",
  "type": "object",
  "properties": {
    "approval_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "action_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "actor_principal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "approver_principal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "approved_capability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "target_scope_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "side_effect_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "decision": {
      "type": "string",
      "enum": [
        "approve",
        "deny"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "usage_policy": {
      "type": "string",
      "enum": [
        "single_use",
        "bounded_use"
      ],
      "description": "single_use has max_uses=1; bounded_use has max_uses>=2."
    },
    "max_uses": {
      "type": "integer",
      "minimum": 1
    },
    "usage_count": {
      "type": "integer",
      "minimum": 0
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "issued",
        "consumed",
        "rejected",
        "revoked",
        "expired"
      ]
    },
    "revocation_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "approval_evidence_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "identity_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "required": [
    "approval_id",
    "tenant_id",
    "action_digest",
    "actor_principal_id",
    "approver_principal_id",
    "approved_capability",
    "target_scope_digest",
    "side_effect_digest",
    "decision",
    "reason",
    "policy_version",
    "approved_at",
    "valid_from",
    "expires_at",
    "usage_policy",
    "max_uses",
    "usage_count",
    "lifecycle_status",
    "revocation_epoch",
    "schema_version",
    "identity_version"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "deny"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "lifecycle_status": {
            "const": "rejected"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "approve"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "lifecycle_status": {
            "enum": [
              "issued",
              "consumed",
              "revoked",
              "expired"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "usage_policy": {
            "const": "single_use"
          }
        },
        "required": [
          "usage_policy"
        ]
      },
      "then": {
        "properties": {
          "max_uses": {
            "const": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "usage_policy": {
            "const": "bounded_use"
          }
        },
        "required": [
          "usage_policy"
        ]
      },
      "then": {
        "properties": {
          "max_uses": {
            "minimum": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_status": {
            "const": "rejected"
          }
        },
        "required": [
          "lifecycle_status"
        ]
      },
      "then": {
        "properties": {
          "decision": {
            "const": "deny"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_status": {
            "const": "consumed"
          }
        },
        "required": [
          "lifecycle_status"
        ]
      },
      "then": {
        "properties": {
          "decision": {
            "const": "approve"
          }
        }
      }
    }
  ]
}
