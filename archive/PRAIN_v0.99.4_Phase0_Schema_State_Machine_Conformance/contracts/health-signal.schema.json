{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prain:schema:health-signal:1.0.0",
  "title": "PRAIN HAL Health Signal",
  "description": "A health signal supports diagnosis; it is not authorization to repair.",
  "type": "object",
  "properties": {
    "signal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:prain:schema:inline-health-scope:1.0.0",
      "title": "Health scope",
      "description": "",
      "type": "object",
      "properties": {
        "scope_type": {
          "type": "string",
          "enum": [
            "component",
            "worker",
            "group",
            "tenant",
            "system"
          ]
        },
        "scope_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        }
      },
      "required": [
        "scope_type",
        "scope_ref"
      ],
      "additionalProperties": false
    },
    "metric": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "value": {
      "type": [
        "number",
        "string",
        "boolean"
      ]
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "status": {
      "type": "string",
      "enum": [
        "healthy",
        "degraded",
        "unhealthy",
        "unknown",
        "stale"
      ]
    },
    "threshold_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "source_principal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
      },
      "uniqueItems": true
    },
    "fresh_until": {
      "type": "string",
      "format": "date-time"
    },
    "schema_version": {
      "const": "1.0.0"
    }
  },
  "required": [
    "signal_id",
    "tenant_id",
    "observed_at",
    "scope",
    "metric",
    "status",
    "source_principal_id",
    "evidence_refs",
    "fresh_until",
    "schema_version"
  ],
  "additionalProperties": false
}
