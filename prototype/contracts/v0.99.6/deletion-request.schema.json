{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prain:schema:deletion-request:1.0.0",
  "title": "PRAIN Deletion Request",
  "description": "Deletion is a cross-store workflow with verified propagation and explicit legal-hold exceptions.",
  "type": "object",
  "properties": {
    "deletion_request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "requested_by_principal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "target_record_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
      },
      "uniqueItems": true
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string",
      "enum": [
        "user_request",
        "retention_expiry",
        "policy_action",
        "correction",
        "security_incident",
        "other"
      ]
    },
    "legal_hold_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
      },
      "uniqueItems": true
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "requested",
        "approved",
        "executing",
        "blocked_legal_hold",
        "verified",
        "partially_verified",
        "rejected"
      ]
    },
    "propagation_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "authoritative_store",
          "events",
          "replicas",
          "projections",
          "vector_indexes",
          "caches",
          "exports",
          "derived_claims",
          "backups"
        ]
      }
    },
    "deletion_receipt_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
      },
      "uniqueItems": true
    },
    "completion_checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 100
    },
    "schema_version": {
      "const": "1.0.0"
    }
  },
  "required": [
    "deletion_request_id",
    "tenant_id",
    "requested_by_principal_id",
    "target_record_refs",
    "requested_at",
    "reason",
    "lifecycle_status",
    "propagation_scope",
    "schema_version"
  ],
  "additionalProperties": false
}
