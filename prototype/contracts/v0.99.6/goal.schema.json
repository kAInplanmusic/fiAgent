{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prain:schema:goal:1.0.0",
  "title": "PRAIN Goal",
  "description": "Completion requires independent evidence for each criterion; the schema alone cannot prove it.",
  "type": "object",
  "properties": {
    "goal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "desired_outcome": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "requester_principal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "owner_principal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "critical"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "accepted",
        "active",
        "blocked",
        "verifying",
        "completed",
        "failed",
        "cancelled",
        "superseded"
      ]
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:prain:schema:inline-goal-criterion:1.0.0",
        "title": "Goal acceptance criterion",
        "description": "",
        "type": "object",
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "verification_method": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "required_evidence_kinds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "uniqueItems": true
          }
        },
        "required": [
          "criterion_id",
          "description",
          "verification_method"
        ],
        "additionalProperties": false
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 100
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
      },
      "uniqueItems": true
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "verification_record_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "blocked_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "schema_version": {
      "const": "1.0.0"
    }
  },
  "required": [
    "goal_id",
    "revision",
    "tenant_id",
    "title",
    "desired_outcome",
    "requester_principal_id",
    "owner_principal_id",
    "priority",
    "status",
    "acceptance_criteria",
    "created_at",
    "updated_at",
    "schema_version"
  ],
  "additionalProperties": false
}
